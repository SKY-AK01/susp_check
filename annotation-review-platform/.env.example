# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=arplatform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=arplatform
DATABASE_URL=postgresql+asyncpg://arplatform:changeme@postgres:5432/arplatform
DATABASE_SYNC_URL=postgresql://arplatform:changeme@postgres:5432/arplatform

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── Storage ────────────────────────────────────────────────────────────────────
DATA_DIR=/data
# Sub-paths resolved by app; see §22.2
# /data/raw-zips/{project_id}/{upload_id}/source.zip
# /data/images/{hash[0:2]}/{hash}.{ext}
# /data/xml-archive/{project_id}/{upload_id}/annotations.xml.gz
# /data/postgres  (bind-mounted Postgres data dir)
# /data/backups   (pg_dump output)

# ── Upload limits ──────────────────────────────────────────────────────────────
MAX_ZIP_SIZE_BYTES=10737418240
MAX_ENTRY_SIZE_BYTES=2147483648
CHUNK_SIZE_BYTES=5242880

# ── Worker / queue ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
INGESTION_BATCH_SIZE=500
COMPARISON_BATCH_SIZE=500
JOB_MAX_ATTEMPTS=3
JOB_HEARTBEAT_TIMEOUT_SECONDS=300

# ── Comparison defaults (all overridable per project) ─────────────────────────
DEFAULT_BOX_IOU_EXACT=0.90
DEFAULT_BOX_IOU_MINOR=0.75
DEFAULT_POLYGON_IOU_EXACT=0.90
DEFAULT_POLYGON_IOU_MINOR=0.60
DEFAULT_OCR_EDIT_DISTANCE_MINOR=1

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
